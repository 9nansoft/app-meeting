# ------------------------
# Application configuration
# ------------------------
APP_PORT=3080

# ------------------------
# Nitro configuration
# ------------------------
NITRO_PORT=3080

# ------------------------
# Session / Security
# ------------------------
# สร้างคีย์ใหม่ทุกครั้งที่ติดตั้ง: bun run gen:key  (ห้ามใช้คีย์ตัวอย่าง/คีย์ที่ commit ไว้)
PASETO_KEY=<RUN: bun run gen:key>
# อายุ session (ชั่วโมง) ค่าเริ่มต้น 8
# SESSION_TTL_HOURS=8
# cookie แบบ Secure (เปิดอัตโนมัติเมื่อ NODE_ENV=production; ตั้ง false เฉพาะทดสอบผ่าน http)
# COOKIE_SECURE=true
# IP ผู้ใช้ใน security log: cloudflare (ค่าเริ่มต้น, ใช้ CF-Connecting-IP) | xff (หลัง reverse proxy ของเราเอง) | none
TRUST_PROXY=cloudflare
# เปิดให้ผู้ใช้สมัครบัญชีเอง (ค่าเริ่มต้นปิด — admin เป็นผู้สร้างบัญชี)
# ALLOW_SELF_REGISTER=false
# Rate limit (login/register/csp-report) แบบใช้ร่วมกันหลาย instance ผ่าน Redis/Valkey
# ไม่ตั้ง = นับในหน่วยความจำของแต่ละ process (พอสำหรับ instance เดียว)
# ถ้า Redis ล่ม ระบบใช้ตัวนับในหน่วยความจำแทนชั่วคราว (login ยังใช้งานได้)
# ใช้ docker-compose.yml ของโปรเจกต์: ตั้งแค่ VALKEY_PASSWORD (บังคับ) แล้ว compose จะส่ง REDIS_URL
# ที่ชี้ไป service valkey ให้แอปเอง — สร้างรหัสด้วย: openssl rand -hex 32 (ใช้ hex เพื่อไม่ต้อง escape ใน URL)
VALKEY_PASSWORD=<RUN: openssl rand -hex 32>
# รันแอปเองนอก compose: ตั้ง REDIS_URL ตรง ๆ
# REDIS_URL=redis://:<password>@127.0.0.1:6379
# REDIS_KEY_PREFIX=app-meeting:rl
# REDIS_RATELIMIT_TIMEOUT_MS=500
# Content-Security-Policy ของหน้าเว็บ: report-only (ค่าเริ่มต้น — รายงานอย่างเดียว) | enforce | off
# ดูรายงานได้ที่ /admin/logs (เหตุการณ์ "CSP violation")
# CSP_MODE=report-only
# โดเมนเพิ่มเติมที่หน้าเว็บเรียก fetch/XHR ได้ (คั่นด้วยช่องว่างหรือจุลภาค)
# CSP_EXTRA_CONNECT_SRC=
# รหัสผ่าน admin ตอนติดตั้งครั้งแรก (ไม่ตั้ง = ระบบสุ่มและพิมพ์ลง log ครั้งเดียว)
# SEED_ADMIN_PASSWORD=
# สร้างบัญชีตัวอย่าง secretary/demo/staff (สำหรับ dev/demo เท่านั้น)
# SEED_DEMO_USERS=false
# SEED_DEMO_PASSWORD=

# ------------------------
# Database configuration (PostgreSQL / Knex)
# ------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=es_nuxt
# หรือใช้ connection string แบบเต็ม:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/es_nuxt

# ------------------------
# Cloudflare Tunnel
# คัดลอกจาก Cloudflare Zero Trust → Networks → Tunnels → (Tunnel ของคุณ) → Token
# ------------------------
TUNNEL_TOKEN=<YOUR_CLOUDFLARE_TUNNEL_TOKEN>
# ------------------------
# File storage (เอกสาร PDF / ไฟล์เสียง)
# ------------------------
STORAGE_DIR=./storage

# ------------------------
# AI provider (OpenAI-compatible: OpenAI / OpenRouter / 9Router ฯลฯ)
# ไม่ตั้ง AI_API_KEY → ระบบทำงานโหมด heuristic (สรุปแบบ extractive ออฟไลน์)
# ------------------------
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_STT_MODEL=whisper-1

# ------------------------
# AI worker — ตั้ง off เพื่อปิด background worker (เช่น แยก worker คนละ instance)
# ------------------------
# AI_WORKER=off

# ------------------------
# OCR สำหรับ PDF สแกน (ใช้อัตโนมัติเมื่อสกัดข้อความไม่ได้)
# - ใช้ tesseract CLI ถ้ามีในระบบ (Docker image ของโปรเจกต์ติดตั้งไว้ให้)
# - ถ้าไม่มี tesseract และตั้ง AI_API_KEY ไว้ จะใช้ AI Vision อ่านภาพแทน
# ------------------------
# OCR_LANGS=tha+eng
# OCR_MAX_PAGES=20
# TESSERACT_CMD=tesseract        # path ของ tesseract ถ้าไม่ได้อยู่ใน PATH

# ------------------------
# Embedding สำหรับค้นหาเชิงความหมายในเอกสาร (สร้างอัตโนมัติเมื่อตั้ง AI_API_KEY)
# ------------------------
# AI_EMBED_MODEL=text-embedding-3-small
